{
  "expo": {
    "name": "ckaccounting",
    "slug": "ckaccounting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/main-icon.png",
    "scheme": "ckaccounting",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Разрешите использовать биометрию для безопасного входа в приложение."
      },
      "bundleIdentifier": "com.aminjon1065.ckaccounting"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/main-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.aminjon1065.ckaccounting"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ck-splash_screen.png",
          "imageWidth": 288,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          },
          "android": {
            "image": "./assets/images/ck-splash_screen.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
          },
          "ios": {
            "image": "./assets/images/ck-splash_screen.png",
            "resizeMode": "cover",
            "backgroundColor": "#ffffff",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите использовать биометрию для безопасного входа в приложение."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите доступ к фото для загрузки изображения товара.",
          "cameraPermission": "Разрешите доступ к камере для съёмки фото товара."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите доступ к камере для сканирования штрихкодов."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-task-manager",
      "expo-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c07260aa-3063-459b-8072-6569bde93aad"
      }
    }
  }
}
